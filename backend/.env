# Server
NODE_ENV=development
PORT=5000

# MongoDB (local)
MONGODB_URI=mongodb://localhost:27017/shopnow

# JWT
JWT_ACCESS_SECRET=shopnow_access_secret_key_2024
JWT_REFRESH_SECRET=shopnow_refresh_secret_key_2024
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d

# Email (Gmail SMTP) - Fill in your credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL=noreply@shopnow.com
FROM_NAME=ShopNow

# Stripe - Fill in your test keys
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Client URL
CLIENT_URL=http://localhost:5173

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
